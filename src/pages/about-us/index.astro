---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Preloader from "@components/Preloader.astro";
import CommonHero from "@components/CommonHero.astro";
import Footer from "@components/Footer.astro";
import VideoPopup from "@components/VideoPopup.astro";
import Profile from "@components/Profile.astro";
import FunFact from "@components/FunFact.astro";
import OurStory from "@components/OurStory.astro";
---

<BaseLayout
    title="Tentang Kami | Omah Kopi 78"
    description="Kenali lebih dekat Omah Kopi 78, tempat makan dan ngopi bernuansa tradisional Jawa dengan suasana nyaman untuk keluarga dan rombongan."
>
    <!-- Preloader -->
    <Preloader />
    <Header />

    <!-- SECTION CONTENT -->
    <div id="scrollsmoother-container">
        <main>
            <CommonHero title="Tentang Kami" breadcrumb="Home" current="about-us" />
            <Profile />
            <FunFact />
            <OurStory />
        </main>
        <div class="ak-height-150 ak-height-lg-60"></div>
        <Footer />
        <div class="loading-overlap"></div>

        <span class="ak-scrollup">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 10L1.7625 11.7625L8.75 4.7875V20H11.25V4.7875L18.225 11.775L20 10L10 0L0 10Z" fill="currentColor"></path>
            </svg>
        </span>

        <VideoPopup />
    </div>
</BaseLayout>
