---
import HeaderAdmin from "@components/admin/HeaderAdmin.astro";
import SidebarAdmin from "@components/admin/SidebarAdmin.astro";
import AdminLayout from "@layouts/AdminLayout.astro";
import pool from "src/lib/db";

// INSERT ketika POST
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();

    await pool.query(
        `
        INSERT INTO menu_categories (name, description, position)
        VALUES (?, ?, ?)
        `,
        [formData.get("name"), formData.get("description"), formData.get("position") ? Number(formData.get("position")) : null]
    );

    return Astro.redirect("/admin/kategori-menu");
}
---

<AdminLayout title="Admin">
    <SidebarAdmin />
    <main class="dashboard-main">
        <HeaderAdmin />

        <!-- FORM ADD -->
        <div class="dashboard-main-body">
            <h6 class="font-semibold mb-6 dark:text-white">Tambah Kategori Menu</h6>

            <form method="POST" class="card border-0 p-6">
                <div class="grid grid-cols-12 gap-4">
                    <div class="col-span-12">
                        <label class="form-label">Nama</label>
                        <input class="form-control border border-neutral-200 dark:border-neutral-600" name="name" required />
                    </div>

                    <div class="col-span-12">
                        <label class="form-label">Keterangan</label>
                        <input class="form-control border border-neutral-200 dark:border-neutral-600" name="description" />
                    </div>

                    <div class="col-span-12">
                        <label class="form-label">Posisi</label>
                        <input class="form-control border border-neutral-200 dark:border-neutral-600" type="number" name="position" required />
                    </div>

                    <div class="col-span-12 flex gap-2 mt-2">
                        <button type="submit" class="btn bg-success-600 hover:bg-primary-700 text-white rounded-lg px-5 py-[11px]"> Simpan </button>

                        <a href="/admin/kategori-menu" class="btn btn-sm text-white bg-primary-600 hover:bg-primary-700"> Batal </a>
                    </div>
                </div>
            </form>
        </div>
    </main>
</AdminLayout>
