---
import HeaderAdmin from "@components/admin/HeaderAdmin.astro";
import SidebarAdmin from "@components/admin/SidebarAdmin.astro";
import AdminLayout from "@layouts/AdminLayout.astro";
import AddMenuForm from "@components/admin/AddMenuForm.jsx";
import pool from "src/lib/db";

// ambil kategori untuk dropdown
const [categories]: any = await pool.query("SELECT id, name FROM menu_categories ORDER BY id ASC");
---

<AdminLayout title="Tambah Menu">
    <SidebarAdmin />
    <main class="dashboard-main">
        <HeaderAdmin />

        <AddMenuForm categories={categories ?? []} client:load />
    </main>
</AdminLayout>;
