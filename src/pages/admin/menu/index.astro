---
import HeaderAdmin from "@components/admin/HeaderAdmin.astro";
import SidebarAdmin from "@components/admin/SidebarAdmin.astro";
import AdminLayout from "@layouts/AdminLayout.astro";
import MenuAdmin from "@components/admin/MenuAdmin.jsx";

const response = await fetch(`${Astro.url.origin}/api/menus`);
const data = await response.json();
---

<AdminLayout title="Kelola Menu">
    <SidebarAdmin />
    <main class="dashboard-main">
        <HeaderAdmin />

        {/* Menu list */}
        <MenuAdmin menu={data ?? []} client:load />
    </main>
</AdminLayout>
