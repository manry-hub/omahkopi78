---
import GalleryAdmin from "@components/admin/GalleryAdmin";
import HeaderAdmin from "@components/admin/HeaderAdmin.astro";
import SidebarAdmin from "@components/admin/SidebarAdmin.astro";
import AdminLayout from "@layouts/AdminLayout.astro";

const response = await fetch(`${Astro.url.origin}/api/spot`);
const data = await response.json();
---

<AdminLayout title="Admin">
    <SidebarAdmin />
    <main class="dashboard-main">
        <HeaderAdmin />
        <GalleryAdmin galleries={data ?? []} client:load />
    </main>
</AdminLayout>
