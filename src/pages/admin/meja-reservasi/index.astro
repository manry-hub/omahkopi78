---
import HeaderAdmin from "@components/admin/HeaderAdmin.astro";
import MejaReservasiAdmin from "@components/admin/MejaReservasiAdmin";
import SidebarAdmin from "@components/admin/SidebarAdmin.astro";
import AdminLayout from "@layouts/AdminLayout.astro";

const response = await fetch(`${Astro.url.origin}/api/reservation-tables`);
const data = await response.json();
---

<AdminLayout title="Admin">
    <SidebarAdmin />
    <main class="dashboard-main">
        <HeaderAdmin />
        <MejaReservasiAdmin reservationTables={data ?? []} client:load />
    </main>
</AdminLayout>
