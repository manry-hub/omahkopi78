---
import AdminLayout from "@layouts/AdminLayout.astro";
import HeaderAdmin from "@components/admin/HeaderAdmin.astro";
import SidebarAdmin from "@components/admin/SidebarAdmin.astro";
import EditFacilityForm from "@components/admin/EditFacilityForm.jsx";
const id = Number(Astro.params.id);
if (!id) {
    return Astro.redirect("/admin/fasilitas");
}
const response = await fetch(`${Astro.url.origin}/api/facility/${id}`);
if (!response.ok) {
    return Astro.redirect("/admin/fasilitas");
}
const facility = await response.json();
---

<AdminLayout title="Edit Fasilitas">
    <SidebarAdmin />
    <main class="dashboard-main">
        <HeaderAdmin />
        <EditFacilityForm facility={facility} client:load />
    </main>
</AdminLayout>
