<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector(".booking-system-form form");
        if (!form) return;

        form.addEventListener("submit", (e) => {
            e.preventDefault();

            const nama = document.getElementById("nama")?.value;
            const nowa = document.getElementById("nowa")?.value;
            const jumlahorang = document.getElementById("jumlahorang")?.value;
            const meja = document.getElementById("meja")?.value;
            const hour = document.getElementById("hour")?.value;
            const date = document.getElementById("date")?.value;

            if (!nama || !meja || !hour || !date || !nowa || !jumlahorang) {
                alert("Lengkapi semua data dulu");
                return;
            }

            const tanggal = new Date(date).toLocaleDateString("id-ID", {
                day: "numeric",
                month: "long",
                year: "numeric",
            });

            const message = `
Halo kak,
saya ingin reservasi di omah kopi 78

- Nama: ${nama}
- No. Whatsapp: ${nowa}
- Jumlah Orang: ${jumlahorang}
- Meja: ${meja}
- Tanggal: ${tanggal}
- Waktu kedatangan: ${hour}

Keterlambatan lebih dari 30 menit membatalkan Reservasi
`.trim();

            const phone = "62811151108";
            const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;

            window.open(url, "_blank");
        });
    });
</script>
